# GoalFlow device agent — Tizen config (KEY=VALUE)
#
# WHY THIS FILE: a Tizen ServiceApplication is NOT launched with the shell
# environment, so environment variables (OPENROUTER_API_KEY, WS_URL, ...) are
# unavailable on the Hub. DeviceConfig reads this file instead. Off-device
# (desktop / Ubuntu-parity) environment variables still take precedence.
#
# SETUP: copy this to `goalflow.conf` and fill in real values. `goalflow.conf`
# is gitignored (it holds a secret). It is bundled into the .tpk (resource dir)
# by the csproj; an on-device writable override may also be placed in the app
# Data dir.

# Required — your OpenRouter API key.
OPENROUTER_API_KEY=sk-or-...

# Optional — defaults shown.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# THIS IS THE ONLY PLACE OPENROUTER_MODEL IS SET: keys are last-one-wins, so a second
# declaration further down would silently beat whatever you edit here.
OPENROUTER_MODEL=openai/gpt-oss-120b

# Optional — per-call LLM deadlines (seconds). Raise these if a large/slow model or
# provider load cancels planning mid-compose ("TaskCanceledException"); a healthy compose
# finishes well under the default. Defaults apply if unset.
# LLM_CALL_TIMEOUT_SECONDS=180     # non-streaming compose / adaptation
# LLM_STREAM_TIMEOUT_SECONDS=210   # streaming grounding pass

# Optional — presenter-mode demo pacing (v5). >0 holds each harness engine's spotlight
# for this many ms so a demo audience can watch the harness pipeline light up
# engine-by-engine. 0/unset = OFF (real, honest timing). Suggested demo value ~1200-1500.
# HARNESS_DWELL_MS=1500

# Cloud hub WebSocket endpoint the device dials out to.
WS_URL=ws://localhost:8000/ws

# Optional — this Hub's identity on the (multi-session) cloud. A session is
# THIS agent + the UIs watching it, keyed by device_id. Leave DEVICE_ID unset:
# a UUID is generated once and persisted in the writable data dir, so the Hub
# keeps one identity across restarts with no configuration.
# DEVICE_ID=kitchen-hub
#
# DEVICE_NAME is the label the UI's device picker shows. Default: user@machine.
# SET THIS when several Hubs share one cloud — it's how a user tells them apart.
# DEVICE_NAME=Kitchen Hub

# Optional — start the simulated clock at a fixed date (ISO). Default: real today.
# GOALFLOW_DATE=2026-07-14

# Optional (v10.0a) — tell another on-Hub app that the day moved. When set, each
# "advance day" fires ONE App Control at this application id carrying a single string
# extra: key "day", value "day 1" / "day 2" / "day 3". The app is launched if it is not
# already running (needs the appmanager.launch privilege, already in tizen-manifest.xml).
# UNSET = off, and nothing is sent. Failures are logged to dlog and never affect the tick.
# DAY_APPCONTROL_APPID=org.example.dayviewer

# Optional — override the mock-world data directory. Default: a writable copy
# seeded into the app Data dir from the bundled resource data.
# GOALFLOW_DATA_DIR=/opt/usr/home/owner/apps_rw/org.goalflow.deviceagent/data

# Optional — log level (Trace|Debug|Information|Warning|Error). Default: Information.
# LOG_LEVEL=Information

# --- v8: MAKE THE HUB FAST. Read this before blaming the model. ---
#
# Measured on Ubuntu with the byte-identical core: the same plan took 59s, 175s, 145s and 189s
# on four runs, then 8-10s once a provider was chosen. Nothing about the prompts changed.
# Unset, OpenRouter load-balances this model across nineteen endpoints whose throughput spans
# 39x (CoreWeave 52 tok/s and Novita 76, against Cerebras 1523).
#
# THE HUB SENDS THIS THE SAME WAY UBUNTU DOES. Both device repos are pinned to Semantic Kernel
# 1.43 — the Hub cannot move (Tizen 12 ships its own System.Text.Json 8.x as a platform
# assembly, and SK >= 1.61 wants 10.x), and Ubuntu matches it on purpose so the dev box
# exercises the SK the Hub runs. SK 1.43 has no ExtraBody, so `provider` rides on the
# HttpClient via OpenRouterBodyHandler, which needs no SK support at all.
#
# CEREBRAS OR NOTHING, and allow_fallbacks=false is the point. Measured on the real pipeline,
# Cerebras plans a goal in 8-10s and the next-best provider takes 203-234s — SLOWER than
# sending no preference. A fallback here is not graceful degradation, it is a silent
# four-minute stall; better to fail visibly and re-run.
OPENROUTER_PROVIDER_ORDER=cerebras
OPENROUTER_PROVIDER_ALLOW_FALLBACKS=false

# Escape hatch for the whole provider object (wins over the two above):
# OPENROUTER_PROVIDER_JSON={"order":["cerebras","groq"],"allow_fallbacks":true}
#
# `openai/gpt-oss-120b:nitro` on the OPENROUTER_MODEL line is an ALTERNATIVE, not a
# requirement: it asks OpenRouter to sort by throughput using nothing but the model id.
# Verified working, and it also lands on Cerebras — but it always allows fallbacks, which is
# exactly what the measurement above says not to do. Keep it as a fallback plan, not the plan.

# --- v8: reasoning_effort. BUILT, SUPPORTED HERE, AND DELIBERATELY LEFT OFF. ---
#
# DO NOT SET THIS TO "low" WITHOUT RE-MEASURING. Benchmarked on every provider: reasoning
# tokens collapse from ~1400 to 26-89 and the model stops being able to do the job — every
# single "low" run returned an INVALID plan. And there is nothing to win: "medium" and the
# provider default are within 0.2s once the provider is fast. Values: minimal|low|medium|high|off.
# LLM_REASONING_EFFORT=medium
# LLM_REASONING_EFFORT_COMPOSE=off
